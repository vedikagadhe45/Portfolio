* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background: #f4f4ff;
    color: #333;
}

header {
    background: white;
    padding: 15px 5%;
    position: sticky;
    top: 0;
}

nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

nav ul {
    display: flex;
    list-style: none;
    gap: 20px;
}

nav a {
    text-decoration: none;
    color: #333;
    font-weight: bold;
}

nav a:hover,
nav a.active {
    color: #4a4ae6;
    border-bottom: 2px solid #4a4ae6;
}

.logo {
    font-weight: bold;
    font-size: 20px;
}

section {
    padding: 40px 5%;
}

.home {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #e6e6ff;
}

.home h1 span {
    color: #4a4ae6;
}

.profile-img {
    border-radius: 50%;
    width: 180px;
    height: 180px;
    object-fit: cover;
}

.btn {
    display: inline-block;
    margin-top: 15px;
    background: #2b6cff;
    color: white;
    padding: 10px 20px;
    border-radius: 20px;
    text-decoration: none;
}

.btn:hover {
    background: #1a4fc4;
}

h2 {
    margin-bottom: 20px;
    border-bottom: 3px solid #4a4ae6;
    display: inline-block;
}

.about-box {
    display: flex;
    gap: 30px;
    align-items: center;
}

.about-box img {
    border-radius: 10px;
}

.skills-grid {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
}

.skill-card {
    background: white;
    padding: 20px;
    border-radius: 10px;
    text-align: center;
    flex: 1;
    min-width: 120px;
    box-shadow: 0 2px 8px #ddd;
}

.skill-card:hover {
    transform: translateY(-5px);
    background: #e6e6ff;
}

.projects-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}

.project-card {
    background: white;
    display: flex;
    gap: 15px;
    padding: 15px;
    border-radius: 10px;
    align-items: center;
}

.project-card:hover {
    box-shadow: 0 4px 12px #bbb;
}

.small-btn {
    display: inline-block;
    margin-top: 8px;
    border: 1px solid #2b6cff;
    padding: 5px 12px;
    border-radius: 15px;
    text-decoration: none;
    color: #2b6cff;
    font-size: 13px;
}

.contact-box {
    display: flex;
    gap: 40px;
}

form {
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
}

input,
textarea {
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 5px;
}

form button {
    background: #2b6cff;
    color: white;
    border: none;
    padding: 12px;
    border-radius: 5px;
    cursor: pointer;
}

form button:hover {
    background: #1a4fc4;
}

footer {
    background: #3b3b7a;
    color: white;
    text-align: center;
    padding: 20px;
}

@media (max-width: 700px) {

    .home,
    .about-box,
    .contact-box {
        flex-direction: column;
        text-align: center;
    }

    .projects-grid {
        grid-template-columns: 1fr;
    }

    nav ul {
        gap: 10px;
        font-size: 13px;
    }
}
